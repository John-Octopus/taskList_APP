{
  "name": "dsh-notes-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Summarize what a conversation has left unresolved and save it as <window name>.md.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./notes": "./notes.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "notes.js",
    "notes.test.mjs",
    "cordis.patch.yml",
    "package.json",
    "icon.svg",
    "locale"
  ],
  "scripts": {
    "test": "node notes.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
